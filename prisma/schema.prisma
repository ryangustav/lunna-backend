// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Schema existente da Lunna
model LunarCoins {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id     String   @unique // Discord ID
  language    String?
  hasVoted    Boolean  @default(false)
  voteTimestamp Int    @default(0)
  vip_type    String   @default("free")
  isVip       Boolean  @default(false)
  vip_timestamp Int    @default(0)
  coins       Int      @default(0)
  prompts_used Int     @default(0)
  image_prompts_used Int @default(0)
  autoRenew Boolean @default(false)
  aboutme     String?     @default("Apenas um viajante estelar explorando o cosmos da Lunna.")
  background_id String?   @default("default")
  base_color  String?     @default("#1F2833")
  insignias   String[]    @default([]) // Legacy field
  
  // Cosmetic Engine Fields
  equipped_frame_id  String?   @db.ObjectId
  equipped_badge_id  String?   @db.ObjectId
  cosmetic_inventory String[]  @default([]) // Array of Cosmetic IDs

  @@map("lunarcoins") 
}

model Cosmetic {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        String   // FRAME, BADGE, BACKGROUND, OVERLAY
  rarity      String   @default("Comum")
  asset_url   String   // Internal path or URL
  is_animated Boolean  @default(false)
  metadata    Json?    // For offsets, layer data, etc.
  createdAt   DateTime @default(now())

  @@map("cosmetics")
}

model Transaction {
  id        String          @id @default(uuid()) @map("_id")
  userId    String
  type      TransactionType
  amount    Float
  paymentId String?    
  name String?
  description String?
  status    String  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@index([paymentId])
}

enum TransactionType {
  VIP
  COINS
  SUBSCRIPTION
}

model VipTier {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique 
  price       Float
  duration    Int      
  coins       Int     
  benefits    String[]
  
  // Associated Rewards
  frame_id    String?  @db.ObjectId
  badge_id    String?  @db.ObjectId
  daily_bonus Float    @default(0) // Percentage multiplier (e.g., 0.15 for 15%)

  @@map("store_vip_tiers")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model VipRenewalAttempt {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  vipTierId         String
  checkoutSessionId String   @unique
  status            String  
  createdAt         DateTime @default(now())
}

model VipDeactivation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  reason    String   
  createdAt DateTime @default(now())
}

model Vote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique
  hasCollected Boolean  @default(false)
  hasVoted    Boolean  @default(false)
  type        String?
  query       String?
  votedAt     DateTime @default(now())

  @@map("votes")
}

model Auth {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique
  hasAuthenticated Boolean  @default(true)
  email            String?
  username         String?
  accessToken      String
  refreshToken     String
  authenticatedAt  DateTime @default(now())

  @@map("auths")
}

model GuildSettings {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  guild_id            String   @unique
  prefix              String   @default("-")
  language            String   @default("pt")
  mod_log_channel     String?
  welcome_channel     String?
  quarantine_role     String?
  anti_spam           Json
  anti_invite         Json
  anti_link           Json
  
  @@map("guild_settings")
}

model Item {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  rarity      String   @default("Comum")
  category    String   @default("Equipamentos")
  icon        String
  stats       Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("rpg_items")
}

model UserItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   // Discord ID (lunarcoins user_id)
  itemId      String   @db.ObjectId
  equipped    Boolean  @default(false)
  quantity    Int      @default(1)
  acquiredAt  DateTime @default(now())

  @@map("user_inventory")
}

model DailyCollect {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id         String   @unique
  daily_collected Boolean  @default(false)

  @@map("dailycollects")
}

model BotTransaction {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id          String   @unique
  transactions     Json     // Stores array of { id, timestamp, mensagem }
  transactions_ids Json     // Stores array of transaction IDs (can be strings or numbers historically)

  @@map("transactions")
}